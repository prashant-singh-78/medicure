# Medicure Backend Environment Configuration Template
# Copy this file to .env and configure real values. Never commit production secrets.

# Security: Cryptographically secure random key for JWT token signing (minimum 16 chars)
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here

# External AI APIs
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (optional override; defaults to SQLite medicines.db)
# DATABASE_URL=sqlite:///./database/medicines.db
